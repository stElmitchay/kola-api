# Monime (Mobile Money Gateway)
MONIME_ACCESS_TOKEN=""
MONIME_SPACE_ID=""
MONIME_WEBHOOK_SECRET=""
MONIME_FINANCIAL_ACCOUNT_ID=""
# Abort Monime requests after this many ms (outcome is unknown on timeout, not a failure)
MONIME_TIMEOUT_MS="15000"

# Solana
HELIUS_URL=""
TREASURY_SECRET_KEY=""
USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"
# Static auth header string configured in the Helius dashboard webhook;
# sent back to us on every callback and verified in constant time.
HELIUS_WEBHOOK_AUTH_HEADER=""

# Supabase
SUPABASE_URL=""
# service-role only; the anon key must never appear in this API
SUPABASE_SERVICE_ROLE_KEY=""

# Auth
# Named admin keys — format "name1:secret1,name2:secret2". Every admin
# action is attributed to the matching name in audit_log.actor (task C2).
ADMIN_KEYS=""
# Deprecated: accepted as a fallback for one release, attributed to actor
# "legacy" in the audit log. Migrate every operator to ADMIN_KEYS above and
# unset this.
ADMIN_SECRET_KEY=""
API_KEY_SALT=""

# Withdrawals (USDC → SLE)
# Fee in basis points (100 = 1%). Applied to USDC->SLE conversion at quote time.
WITHDRAWAL_FEE_BPS="100"
# Min/max per-transaction in USDC minor units (1 USDC = 1_000_000)
WITHDRAWAL_MIN_USDC="100000"
WITHDRAWAL_MAX_USDC="100000000"
# Rolling 24h cap per phone number in USDC minor units
WITHDRAWAL_DAILY_CAP_USDC="500000000"

# Deposits (SLE minor units, 1 SLE = 100)
DEPOSIT_MIN_SLE="100"
DEPOSIT_MAX_SLE="500000"

# Exchange rate guards
# Max age of the active rate before deposits/withdrawals refuse to quote it
RATE_MAX_AGE_MINUTES="1440"
# Max move (basis points) allowed when setting a new rate without force:true
RATE_MAX_MOVE_BPS="500"

# CORS
# Comma-separated list of allowed browser origins (e.g. https://app.kola.example,https://admin.kola.example)
ALLOWED_ORIGINS=""

# Kill switch
# Set to "1" to pause all state-changing traffic (deposits, withdrawals, webhooks) during an incident
KOLA_PAUSE=""

# Cron workers (POST /internal/transfer-tick, /internal/reconcile-tick) —
# Vercel cron sends this as "Authorization: Bearer $CRON_SECRET";
# "X-Cron-Secret: $CRON_SECRET" is also accepted for manual/operator triggers.
CRON_SECRET=""

# Reconciliation cron (POST /internal/reconcile-tick) — minutes a deposit/
# withdrawal/transfer_job may sit in a non-terminal state before the stuck-
# state sweep surfaces it as an alert.
STUCK_THRESHOLD_MINUTES="30"

# Rate limiting (task C3, F20)
# Upstash Redis REST credentials backing the per-API-key sliding-window
# rate limiter (auth_api_keys.rate_limit, requests/minute). If either is
# unset, rate limiting fails open (passes every request through, logs a
# single warning) — money paths must not go down because Redis is
# unconfigured or unreachable.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Error tracking (task C4). Optional — Sentry init is a no-op without this,
# and captureError() never throws either way.
SENTRY_DSN=""

# Vercel
NODEJS_HELPERS="0"
