# Withdrawals (USDC → SLE)
# Fee in basis points (100 = 1%). Applied to USDC->SLE conversion at quote time.
WITHDRAWAL_FEE_BPS="100"
# Min/max per-transaction in USDC minor units (1 USDC = 1_000_000)
WITHDRAWAL_MIN_USDC="100000"
WITHDRAWAL_MAX_USDC="100000000"
# Rolling 24h cap per phone number in USDC minor units
WITHDRAWAL_DAILY_CAP_USDC="500000000"

# Deposits (SLE minor units, 1 SLE = 100)
DEPOSIT_MIN_SLE="100"
DEPOSIT_MAX_SLE="500000"

# Exchange rate guards
# Max age of the active rate before deposits/withdrawals refuse to quote it
RATE_MAX_AGE_MINUTES="1440"
# Max move (basis points) allowed when setting a new rate without force:true
RATE_MAX_MOVE_BPS="500"

# Vercel
NODEJS_HELPERS="0"
