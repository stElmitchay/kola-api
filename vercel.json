{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/webhooks/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    { "path": "/api/internal/transfer-tick", "schedule": "0 3 * * *" },
    { "path": "/api/internal/reconcile-tick", "schedule": "30 3 * * *" }
  ]
}
